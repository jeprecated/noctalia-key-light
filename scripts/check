#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
jq -e '.id == "key-light" and .entryPoints.barWidget == "BarWidget.qml"' key-light/manifest.json >/dev/null
for file in key-light/*.qml; do
  qmlformat "$file" >/dev/null
done
if [[ ${KEY_LIGHT_LIVE_TEST:-0} == 1 ]]; then
  response=$(curl --fail --silent --show-error "http://${KEY_LIGHT_HOST:-elgato-key-light-mk-2-1cf4.local}:9123/elgato/lights")
  jq -e '.numberOfLights == 1 and (.lights | length) == 1' <<<"$response" >/dev/null
fi
echo "checks passed"
