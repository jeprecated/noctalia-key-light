#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PYTHONDONTWRITEBYTECODE=1
jq -e '.id == "studio-controls" and .entryPoints.main == "Main.qml" and .metadata.defaultSettings.devices == [] and .metadata.defaultSettings.controls == [] and .metadata.defaultSettings.actions == []' studio-controls/manifest.json >/dev/null
for file in studio-controls/*.qml; do
  qmlformat "$file" >/dev/null
done
python3 -m unittest discover -s tests -p 'test_*.py' -v
python3 tests/test_qml.py
echo "Studio Controls checks passed (synthetic devices only)"
